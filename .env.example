# Supabase — haal op via https://supabase.com → project → Settings → API Keys
VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Zet pas op true als Twilio, Supabase Edge Functions en een browser/microfoon-test werken.
VITE_ENABLE_VOICE_CALLS=false

# Twilio — zet deze ALLEEN in Supabase Edge Function secrets, NIET in Vite
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_API_KEY=SK...
# TWILIO_API_SECRET=...
# TWILIO_TWIML_APP_SID=AP...

# Zonder VITE_SUPABASE_URL en VITE_SUPABASE_ANON_KEY draait de app automatisch
# in demo-modus met lokale voorbeelddata. Handig voor previews.
